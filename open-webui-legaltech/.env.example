# 複製成 .env 後填入。.env 已列入 .gitignore，不要提交。

# Anthropic API 金鑰（https://platform.claude.com/ → API Keys）
ANTHROPIC_API_KEY=

# 以下皆為選填，預設值如右。
# BASE_MODEL=claude-opus-5-5          # 較省錢可改 claude-sonnet-5-5 或 claude-haiku-5-5
# TASK_MODEL=claude-haiku-5-5        # 產生對話標題、標籤用的便宜模型
# WEBUI_PORT=3000
# OPEN_WEBUI_TAG=v0.13.4
# MCP_URL=https://legaltech.org.tw/mcp
